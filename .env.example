APP_NAME=Learning LLM API
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=AQ.Ab8RN6KyOVIW6AZOFbcS-LWRo-b9TITRnxbBoe4O9T6G4iuTlA
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2048
API_PORT=8000
OLLAMA_IMAGE=ollama/ollama:latest

# Encode special characters in the password when constructing DATABASE_URL.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://app:changeme@localhost:5432/semantic_search
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_JOB_POLL_SECONDS=5
EMBEDDING_JOB_LEASE_SECONDS=600
EMBEDDING_JOB_RETRY_SECONDS=5

ADMIN_USERNAME=admin
# Set a password before using the admin site. Empty disables admin access.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=false
ADMIN_TENANT_ID=demo

STORE_COOKIE_SECURE=false
SHIPPING_FEE_VND=30000

# Monitoring (Grafana first startup; defaults to ADMIN_PASSWORD when omitted)
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=http://127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=choose-a-password
LOG_LEVEL=INFO
